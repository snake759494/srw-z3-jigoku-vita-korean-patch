{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pcsg00264:schema:retranslation-overlay:v1",
  "title": "시옥편 신규 번역 오버레이",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "scope",
    "assetKey",
    "baseline",
    "translationPolicy",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "siok-retranslation-overlay"
    },
    "formatVersion": {
      "const": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "assetKey": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "rowCount"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rowCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "translationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "existingTranslations"
      ],
      "properties": {
        "method": {
          "const": "fresh-from-japanese"
        },
        "existingTranslations": {
          "const": "reference-only"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entryId",
          "sourceBindingSha256",
          "sourceTextSha256",
          "freshTranslation",
          "translationStatus",
          "translator",
          "referenceConsulted",
          "notes"
        ],
        "properties": {
          "entryId": {
            "type": "string",
            "pattern": "^[^/\\s]+/[^/\\s]+/[0-9]{6}$"
          },
          "sourceBindingSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sourceTextSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "freshTranslation": {
            "type": "string",
            "minLength": 1
          },
          "translationStatus": {
            "enum": [
              "draft",
              "reviewed",
              "blocked"
            ]
          },
          "translator": {
            "type": "string",
            "minLength": 1
          },
          "reviewer": {
            "type": "string"
          },
          "referenceConsulted": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
