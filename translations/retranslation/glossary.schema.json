{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pcsg00264:schema:retranslation-glossary:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "characters",
    "terms",
    "rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "siok-retranslation-glossary"
    },
    "formatVersion": {
      "const": 1
    },
    "characters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayName",
          "speechStyle"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "speechStyle": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "terms": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
