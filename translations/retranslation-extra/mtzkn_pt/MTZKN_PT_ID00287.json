    {
      "entryId": "MTZKN_PT_ID00287/Sheet1/000007",
      "sourceBindingSha256": "a9254ec00f34aa62bffa79d3e84950dd8df1b0a68876c8ad4ad9e583e1901523",
      "sourceTextSha256": "12ffcdc726864849287a7207f92b4f74209507415cecff7605a9b859ed39003f",
      "freshTranslation": "미스릴 정보부의 부원. 레이스는 코드 네임. ㊥ 위스퍼드인 치도리 카나메가 다른 기관에 건너는 것을 저지하는 작전 「가디언・㊥엔젤」에 종사. 소스케와 병행하여, 비밀리에 그녀의 호위를 하고 있었지만, 양자의 사이에㊥에 제휴는 없고, 소스케는 그 존재를 알려지지 않았다. ㊥ 변장의 명수로, 다양한 얼굴과 목소리를 갖고, 카나메가 접촉했을 때에는 눈에 띄지 않는 중년 남성㊥에 분장하고 있었다. ㊥타마란이 카나메를 습격할 때에는 총격을 받고 부상을 당하고 사실상 임무에 실패한다. ㊥ 가나메가 자력으로 위기를 뚫었을 때에는 스스로의 불갑당한 슬픔이었지만, 참으로 ㊥ 질타당해 그녀를 홍콩까지 데려갔다. ㊥ 덧붙여 그 정체는 여성이다.",
      "translationStatus": "draft",
      "translator": "Google Translate ja→ko (자동 초안)",
      "reviewer": "",
      "referenceConsulted": false,
      "notes": "일본어 원문 기준 자동 번역 초안; 기존 번역 미참조"
    }
