    },
    {
      "entryId": "MTZKN_PT_ID00101/Sheet1/000011",
      "sourceBindingSha256": "ddde1e4727967830ab12d2596e04439a5fa448a748132dd84e7c45dd7537b665",
      "sourceTextSha256": "d8c52097a372e046805d1743d30749563ed76ebfad7d0924a644a20e535bba78",
      "freshTranslation": "루비잉이 괴멸한 뒤에도 한 명, 반괴해 ㊥한 건담 엑시아에서 싸움을 계속하고 있었지만, 프톨레마이오스 2에 합류해, 트윈드라㊥ 이브를 탑재한 더블 오건담에 탑승하게 된다. ㊥ 싸움 속에서 만난 마리나의 한결같이 평화를 기원하는 자세에는 부정적이었지만, ㊥ 이윽고 마음속에 변화가 나타나고, 유엔군과의 최종 결전에 임하기 전에는, 마리나를 향해 메일 ㊥를 보냈다. ㊥국가를 잃은 마리나와도 재회하지만 연인끼리를 묻는 밀레이나에게는 즉답으로 부정하고 ㊥하는 것에서도 두 사람의 관계는 연애와는 별개였다. ㊥ 사자의 탑승하는 오라이저와의 합체 형태인 더블 오라이저로 계속 싸우고, ㊥ 트윈 라이브의 생성하는 대량의 GN 입자에 의해, 이노베이",
      "translationStatus": "draft",
      "translator": "Google Translate ja→ko (자동 초안)",
      "reviewer": "",
      "referenceConsulted": false,
      "notes": "일본어 원문 기준 자동 번역 초안; 기존 번역 미참조"
    },
