    {
      "entryId": "MTZKN_PT_ID00139/Sheet1/000008",
      "sourceBindingSha256": "cb1ad495375f7f8cab76700cc021ddc8b5136558bae2de720c088b0ceba2141f",
      "sourceTextSha256": "608260fe2863004c9bae52bb0a54111a7e2d665e253f8bdbfa214e679516ae00",
      "freshTranslation": "입부대의 지휘관으로 알려져 있다. ㊥ 그 경력이 위험시되어 군의 본류에서 벗어나고 있지만 정치적인 의㊥ 향을 차단하는 정직함과 풍부한 실전 경험에서 부하의 신뢰는 두껍다. ㊥ 제2차 네오지온 항쟁에서는 론도벨을 이끌고, 부하이며 동맹이기도 한 아무로 ㊥ 레이와 함께 샤아의 지구 한랭화 작전을 저지했다. ㊥ 비스트 재단 앞서 상자를 둘러싼 사건의 수렴을 도모하려는 로난 마르세나스의 ㊥원의 의뢰에 의해 지구에 강하한 갈란셰일을 쫓는다.",
      "translationStatus": "draft",
      "translator": "Google Translate ja→ko (자동 초안)",
      "reviewer": "",
      "referenceConsulted": false,
      "notes": "일본어 원문 기준 자동 번역 초안; 기존 번역 미참조"
    },
