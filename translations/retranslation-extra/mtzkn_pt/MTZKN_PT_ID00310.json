    {
      "entryId": "MTZKN_PT_ID00310/Sheet1/000008",
      "sourceBindingSha256": "425475a3999b92d9d4c37f27513f1033f72b3495a1fca9a4dd894a843aa6b7e5",
      "sourceTextSha256": "3fc52d5f8b17f2fc88cf64e04f3f5f548de174a1ddc9451222b396661755369b",
      "freshTranslation": "예. ㊥ 테펠린 함락 후에는 신정부에 대한 반정부 게릴라 활동에 몸을 던진다. ㊥ 게릴라로서의 전투에 패한 후 투옥되었지만 의외의 형태로 시몬과 재회. 자 ㊥ 등에 인류 섬멸 시스템이 발동한 것으로, 그것을 깨기 위해 과거의 숙적과 손을 잡는 ㊥ 일이 되었다. ㊥ 수인이기 때문에 나선력이야말로 가지지 않지만, 그 뛰어난 감정 조종 기술을 전망 ㊥ 글렌의 시트에 앉는다. 자신의 괴상한",
      "translationStatus": "draft",
      "translator": "Google Translate ja→ko (자동 초안)",
      "reviewer": "",
      "referenceConsulted": false,
      "notes": "일본어 원문 기준 자동 번역 초안; 기존 번역 미참조"
    },
