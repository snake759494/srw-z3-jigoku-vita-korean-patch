    {
      "entryId": "MTZKN_RT_ID00022/Sheet1/000006",
      "sourceBindingSha256": "1d55aad0705948a33425bfdd39a1aa3b30c2f85e77b12233239c9fb037057871",
      "sourceTextSha256": "c8148173cff94be7dfc4bd53c3426e6dcecb97ab319c9fe0022cb0f389f5de0a",
      "freshTranslation": "쿠엔트 별의 수도 고모르에서 움켜 올린 AT. ㊥ 명칭의 DT는 「Desert-Trip」의 의미. ㊥ 극히 높은 색적 능력을 가진 퀀트 소자식 금속 탐지 센서와 왼팔에 대비한 파이 ㊥ 루뱅카, 전용의 돌격 소총 등 독자적이고 고성능의 장비를 가진다. ㊥ 다른 베르젤가와 마찬가지로 1 대에 파견되는 전지에 적응 한 카스",
      "translationStatus": "draft",
      "translator": "Google Translate ja→ko (자동 초안)",
      "reviewer": "",
      "referenceConsulted": false,
      "notes": "일본어 원문 기준 자동 번역 초안; 기존 번역 미참조"
    },
    {
      "entryId": "MTZKN_RT_ID00022/Sheet1/000007",
      "sourceBindingSha256": "92c9b4c442dc32ccff63e9ed110ab739c7679ad3e15b63e1359596da94620bf8",
