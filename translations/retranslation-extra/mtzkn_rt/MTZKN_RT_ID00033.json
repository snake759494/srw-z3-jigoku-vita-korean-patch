    {
      "entryId": "MTZKN_RT_ID00033/Sheet1/000008",
      "sourceBindingSha256": "042bb6db2c242e5367d1afe1dd8ae9437eb59011216b21e35003b2be0fef7034",
      "sourceTextSha256": "855bf57f6f8f82030294721a7778575d0bf02e5309f7408d22f42027caf89ea5",
      "freshTranslation": "-의 채용에 의해 파워 웨이트 레시㊥오가 뛰어나군을 뽑은 기동력을 실현하고 있다. 그 높은 출력은 메가 바주카 라㊥인처에도 필적하는 위력을 가진 휴대 무기, 하이퍼 메가 런처의 사용을 가능㊥능으로 한다. ㊥ 더 웨이브 라이더로 변형함으로써 장대한 항속력과 가속력을 발휘한다. ㊥ 단기로의 대기권 돌입이나 대기권 내에서 단독 비행, 동료를 등에 탑재한 작전 행동 등 ㊥ 모든 장면에서 활약이 가능한 기체가 되고 있다. ㊥ 후에 간이 사이코뮤인 바이오센서가 탑재된 것으로, 갈라진 게 ㊥유의 반응에 대한 추종성을 손에 넣었다. 게다가 적모빌슈트의 움직임에 간섭해 정지 ㊥ 정지시키는 등, 사양에는 포함되지 않는 불가해한 현상의 발현도 확인되고 있다.",
      "translationStatus": "draft",
      "translator": "Google Translate ja→ko (자동 초안)",
      "reviewer": "",
      "referenceConsulted": false,
      "notes": "일본어 원문 기준 자동 번역 초안; 기존 번역 미참조"
    },
